<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>BozForge.Bogus.Turkiye</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>BozForge.Bogus.Turkiye</PackageId>
    <Version>0.1.0</Version>
    <Description>Türkiye'ye özgü test verisi için Bogus eklentisi: kontrol haneleri tutan TCKN ve VKN, gerçek banka kodlu TR IBAN, herkese açık test kartları ve GSM numarası. Turkish test data extensions for Bogus.</Description>
    <PackageTags>bogus;faker;test-data;turkey;turkiye;tckn;vkn;iban;türkiye</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/BozForge/bogus-turkiye</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BozForge/bogus-turkiye</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="BozForge.Bogus.Turkiye.Tests" />
  </ItemGroup>

</Project>
